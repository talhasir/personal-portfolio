RESEND_API_KEY=
CONTACT_TO=talhahafiz145@gmail.com
# A sender on a domain verified in Resend; leave empty to use Resend's test sender.
CONTACT_FROM=

# Portal (/admin). Run `npm run admin:password` to fill these three.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Portal saves on the live site: each save is committed to this repo and Vercel redeploys.
# A fine-grained GitHub token with "Contents: Read and write" on this one repository.
GITHUB_TOKEN=
# owner/name, like talhasir/portfolio
GITHUB_REPO=
GITHUB_BRANCH=main
