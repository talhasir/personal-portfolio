  "principles": [
    {
      "title": "Own it in production",
      "text": "I build it, release it and stay on it when something breaks, then write down the cause and the fix."
    },
    {
      "title": "Integrations that survive failure",
      "text": "Webhooks stored before processing, idempotent writes, retries with backoff, so one bad call never doubles or loses data."
    },
    {
      "title": "AI with a person in the loop",
      "text": "AI proposes, a person approves, and every change can be undone."
    },
    {
      "title": "Measured releases",
      "text": "Small changes, checked before and after release, with backups ready."
    }
